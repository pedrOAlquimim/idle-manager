{
  "name": "idlemanager",
  "productName": "IdleManager",
  "version": "0.1.0",
  "description": "Runs browser-game accounts in isolated sessions",
  "author": "Pedro",
  "homepage": "https://idlemanager.invalid",
  "desktopName": "idlemanager.desktop",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "dist:linux": "npm run build && electron-builder --linux deb --x64"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
